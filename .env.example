# MPay Environment Configuration
# 复制此文件为 .env 并根据需要修改配置

# ==================== 应用配置 ====================
# 应用调试模式（生产环境请设为 false）
APP_DEBUG=false

# 应用端口（容器对外暴露的端口）
APP_PORT=8080

# ==================== 数据库配置 ====================
# MySQL 数据库名
DB_NAME=mpay

# MySQL 用户名
DB_USER=mpay

# MySQL 密码（请修改为强密码）
DB_PASS=mpay123456

# MySQL 表前缀
DB_PREFIX=mpay_

# MySQL Root 密码（请修改为强密码）
MYSQL_ROOT_PASSWORD=rootpassword

# MySQL 对外端口（设为空则不暴露）
MYSQL_PORT=3306

# ==================== 可选服务 ====================
# phpMyAdmin 端口（需要使用 --profile tools 启动）
PMA_PORT=8081

# Redis 端口（需要使用 --profile cache 启动）
REDIS_PORT=6379
